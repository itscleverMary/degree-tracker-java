<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #DAA06D; -fx-background-insets: 2;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TextField fx:id="userInput" layoutX="208.0" layoutY="185.0" prefHeight="31.0" prefWidth="188.0" />
      <Label fx:id="informLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="7.0" layoutY="90.0" prefHeight="97.0" prefWidth="587.0" text="Do you already have an account? (Y/N)" textAlignment="CENTER">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="98.0" layoutY="46.0" prefHeight="57.0" prefWidth="404.0" text="Log In/Sign Up Page">
         <font>
            <Font name="Franklin Gothic Medium" size="34.0" />
         </font>
      </Label>
      <Button fx:id="defaultPageEnterButton" layoutX="248.0" layoutY="228.0" mnemonicParsing="false" onAction="#onEnterButtonClick" prefHeight="31.0" prefWidth="105.0" text="Enter" />
   </children>
</AnchorPane>
